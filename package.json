{
  "name": "penclone",
  "version": "0.1.0",
  "description": "Text in your own handwriting, rendered from your real pen strokes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "penclone": "bin/penclone.js"
  },
  "exports": {
    ".": "./engine/index.js",
    "./node": "./engine/node.js",
    "./commands": "./lib/commands.js"
  },
  "files": [
    "bin/",
    "engine/",
    "lib/",
    "skill/",
    "pipeline/*.py",
    "pipeline/requirements.txt",
    "tools/glyph_report.py",
    "docs/guide.md",
    "docs/de/anleitung.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/migl06/penclone.git"
  },
  "keywords": [
    "handwriting",
    "mcp",
    "pdf",
    "svg",
    "german",
    "hyphenation",
    "ink"
  ]
}
